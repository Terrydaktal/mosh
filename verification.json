  "requirements": [
    {
      "id": "HISTORY-01",
      "contract": "loss, duplicate and delayed batches preserve retained records exactly once",
      "tests": [
        "tests/native_history_test.cc",
        "tests/test_terminal.py::test_history_reaches_native_scrollback"
      ]
    },
    {
      "id": "HISTORY-02",
      "contract": "retention and record sizes are bounded; expiry and overlong lines are explicit",
      "tests": [
        "tests/native_history_test.cc"
      ]
    },
    {
      "id": "HISTORY-03",
      "contract": "outage and client-address roaming recover undelivered retained history",
      "tests": [
        "tests/test_terminal.py::test_outage_and_roaming_recover_undelivered_history"
      ]
    },
    {
      "id": "HISTORY-04",
      "contract": "finite command EOF drains queued history before normal shutdown",
      "tests": [
        "tests/test_terminal.py::test_finite_command_drains_history_before_exit"
      ]
    },
    {
      "id": "TTY-01",
      "contract": "terminal owns scrolling; no alternate screen, copy-mode mouse capture or duplicate repaint scrolls",
      "tests": [
        "tests/test_terminal.py::test_history_reaches_native_scrollback",
        "tests/native_history_test.cc"
      ]
    },
    {
      "id": "TTY-02",
      "contract": "short logical history records survive tested growth, shrink and width changes, including resume/resize signal ordering",
      "tests": [
        "tests/test_terminal.py::test_resize_during_history_transfer",
        "tests/test_terminal.py::test_resize_after_delivery_and_before_any_history"
      ]
    },
    {
      "id": "ORDINARY-01",
      "contract": "ordinary Mosh stays stock-wire-compatible on the separate tmux transport path",
      "tests": [
        "tests/test_terminal.py::test_ordinary_mosh_path_remains_stock_wire_compatible"
      ]
    },
    {
      "id": "COMPAT-01",
      "contract": "stock protocol peers are explicitly rejected",
      "tests": [
        "tests/test_terminal.py::test_stock_peer_is_rejected"
      ]
    },
    {
      "id": "BUILD-01",
      "contract": "pinned source, reproducible clean patch build and separate non-overwriting symlink install",
      "tests": [
        "scripts/build.sh",
        "scripts/link.sh",
        "tests/test_terminal.py::test_wrapper_resolves_its_own_client_outside_path"
      ]
    },
    {
      "id": "BUILD-02",
      "contract": "Termux installer requests the separate protobuf compiler package and verifies protoc before source extraction or build",
      "tests": [
        "tests/test_install.py::test_phone_installer_installs_and_checks_compiler"
      ]
    },
    {
      "id": "TTY-03",
      "contract": "keyboard resize bursts coalesce over 120 ms; stale-sized remote frames are not drawn and input/network processing continues",
      "tests": [
        "tests/test_terminal.py::test_keyboard_resize_never_draws_old_geometry",
        "tests/native_history_test.cc"
      ]
    },
    {
      "id": "BUILD-03",
      "contract": "Termux upgrades replace only recognized prior bundle symlinks, keep old binaries, and refuse unrelated paths without partial updates",
      "tests": [
        "tests/test_install.py::test_termux_upgrade_only_replaces_owned_links"
      ]
    },
    {
      "id": "COMPAT-02",
      "contract": "native2 client works with a native1 server without restarting the persistent session",
      "tests": [
        "tests/test_terminal.py::test_keyboard_resize_never_draws_old_geometry",
        "tests/test_terminal.py::test_history_reaches_native_scrollback"
      ]
    },
    {
      "id": "STATUS-01",
      "contract": "direct native-history servers expose authenticated packet age through the existing owner-only API; queries, replay and invalid UDP do not refresh age; inventory and scoped cleanup use it",
      "tests": [
        "tests/test_status.py"
      ]
    },
    {
      "id": "COMPAT-03",
      "contract": "the previously installed native2 client works with the rebuilt packet-reporting server without any history or wire-protocol change",
      "tests": [
        "tests/test_status.py::test_packet_age_inventory_and_cleanup_work_with_direct_history[existing-native2]"
      ]
    },
    {
      "id": "TTY-04",
      "contract": "Native4 Termux retains wide ASCII/Unicode output once and in order through repeated severe zoom; preserved resize archives cover every bounded wire batch, not just the first",
      "tests": [
        "tests/test_zoom.py",
        "tests/native_history_test.cc::resize_history_spans_batches"
      ]
    },
    {
      "id": "BUILD-04",
      "contract": "A clean host/Termux build includes the activated terminal-model launcher and reflow source changes as ordered patches, with old builds retained",
      "tests": [
        "tests/test_terminal.py::test_real_wrapper_launches_matching_client_without_path_entry",
        "scripts/build.sh"
      ]
    },
    {
      "id": "TTY-05",
      "contract": "Native5 preserves reproduced whitespace-heavy Fish output through severe slow and rapid Termux zoom without losing or duplicating table records",
      "tests": [
        "tests/test_zoom_artifacts.py"
      ]
    },
    {
      "id": "INPUT-01",
      "contract": "Resize cursor reports remain local; fragmented replies, stale geometry, ordinary keys, malformed bounds, timeout and late replies are bounded and isolated",
      "tests": [
        "tests/native_history_test.cc"
      ]
    },
    {
      "id": "ORACLE-01",
      "contract": "The terminal padding-wrap defect is reproduced independently without Mosh and distinguished from transport text loss",
      "tests": [
        "tests/test_termux_padding.py"
      ]
    },
    {
      "id": "TTY-06",
      "contract": "The Termux-specific cursor reflow model includes the empty cursor cell on width changes, avoiding repeated retired row fragments at exact width boundaries",
      "tests": [
        "tests/native_history_test.cc::cursor_boundary_resize",
        "tests/test_tiny_zoom.py"
      ]
    },
    {
      "id": "ORACLE-02",
      "contract": "Whitespace-compacted text is not enough: exact table/prose line structure is separately checked against both the installed-version emulator and the independent Termux source fix",
      "tests": [
        "tests/test_tiny_zoom.py",
        "tests/test_termux_padding.py"
      ]
    }
  ],
